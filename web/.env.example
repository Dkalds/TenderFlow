# Variables de entorno del frontend (web/).
#
# Este fichero existe porque `scripts/check_env_parity.py` compara
# `config/settings.py` con el `.env.example` y el `render.yaml` de la raíz —es
# decir, solo el backend—, y las del frontend quedaban fuera de todo guard. El
# resultado fue una variable fantasma: `NEXT_PUBLIC_CONTACT_EMAIL` no aparecía
# documentada en ningún sitio del repositorio, así que un despliegue nuevo
# heredaba en silencio un CTA de "Solicita acceso" que moría en /login, donde el
# alta self-service responde 403. Ningún test lo delataba, porque el e2e acepta
# a propósito las dos ramas del destino.
#
# Cuidado con `NEXT_PUBLIC_*`: Next las inlinea en el bundle **en tiempo de
# build**. Cambiarlas en Vercel no basta — hay que redesplegar sin caché de
# build, o el valor viejo sigue horneado en el JavaScript servido.

# ── Obligatorias en producción ───────────────────────────────────────────────

# Origen del backend FastAPI. Lo usan los `rewrites()` de next.config.ts y el
# fetch SSR de la superficie pública (lib/publico-api). En Vercel es obligatoria:
# el build falla a propósito si falta, para no desplegar una web sin datos.
API_BASE_URL=http://localhost:8080

# ── Opcionales ───────────────────────────────────────────────────────────────

# Buzón público de solicitudes de acceso. Sin ella el CTA de la landing enlaza a
# /login y el pie pierde su enlace de contacto; el aviso legal declara entonces
# que no hay dirección publicada, en vez de inventarse una.
NEXT_PUBLIC_CONTACT_EMAIL=

# URL canónica del sitio, para metadatos, canonical, sitemap y Open Graph. Sin
# ella se deduce del dominio de Vercel. Ponerla al tener dominio propio.
NEXT_PUBLIC_SITE_URL=

# Enlace a los paneles de Grafana desde la vista de observabilidad. Sin ella el
# acceso directo no se ofrece (ADR-014: nada de URLs de operación hardcodeadas).
NEXT_PUBLIC_GRAFANA_URL=

# "1" reactiva la pestaña de "Crear cuenta" en /login. Por defecto está oculta:
# en producción `ALLOW_SELF_REGISTRATION` está apagado y el alta responde 403,
# así que enseñar el formulario solo servía para que alguien lo rellenara y se
# encontrara un error. Debe ir en paralelo con la del backend.
NEXT_PUBLIC_ALLOW_SELF_REGISTRATION=
