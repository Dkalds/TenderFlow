# Variables de entorno — copia este archivo como .env y rellena los valores
# NUNCA commitees .env al repositorio

# ── Entorno ─────────────────────────────────────────────────────────
# Default: prod (fail-safe). Usar dev solo en desarrollo local.
# En dev: CORS wildcard habilitado, DB init errors no fatales.
# ENV=dev
ENV=prod

# Perfil de componentes que arranca el proceso. Eje independiente de ENV:
# ENV dice qué datos se tocan, APP_PROFILE qué se arranca.
#   api     — sirve HTTP: exige SIGNING_KEY, API_HMAC_SECRET, REDIS_URL, CORS.
#   scraper — cron de ingesta: solo validators de BD y alertas.
#   worker  — jobs de fondo: igual que scraper.
APP_PROFILE=api

# ── Base de datos ──────────────────────────────────────────────────────
# Postgres es el ÚNICO motor soportado (ADR-021): dev, CI y producción.
# SQLite se retiró — `DB_PATH` ya no existe.
#
# Dev local: `docker compose up -d postgres` levanta el servicio del compose.
#   DATABASE_URL=postgresql://tenderflow:tenderflow@localhost:5432/tenderflow?sslmode=disable  # pragma: allowlist secret -- contenedor local de dev, no es una credencial real
# `sslmode=disable` sólo es aceptable contra localhost (sin red que interceptar);
# config/settings.py lo rechaza contra cualquier host remoto, sea cual sea ENV.
#
# Producción: Postgres / Supabase (ADR-016).
# Usar el Supavisor *session pooler* (puerto 5432; IPv4, compatible con GH Actions).
# TLS: en ENV=prod/staging se recomienda verify-full + la CA de Supabase para
# prevenir MITM (sslmode=require cifra pero NO valida el certificado del servidor).
# NOTA: sslmode=disable/allow/prefer se RECHAZAN en prod/staging (no garantizan TLS).
# DATABASE_URL=postgresql://<user>:<pass>@<host>:5432/<db>?sslmode=verify-full  # pragma: allowlist secret
# Ruta al certificado CA raíz de Supabase (Dashboard → Database → SSL → download).
# Requerido para verify-full. No es un secreto (cert público).
# DATABASE_SSL_ROOT_CERT=db/certs/prod-ca-2021.crt
# Timeouts server-side aplicados a cada conexión del pool (ms). Protegen el pool
# frente a queries descontroladas o transacciones idle. 0 = sin límite.
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_TX_TIMEOUT_MS=60000
# DB_CONNECT_TIMEOUT=10
#
# DSN del rol DUEÑO del schema — el único con DDL y el único que bypassa la RLS
# de v52. NO va en el servicio web de Render ni en el .env de la API: lo usa
# EXCLUSIVAMENTE .github/workflows/migrate.yml para `alembic upgrade`
# (APP_PROFILE=scraper). `config/settings.py` no lo declara como campo de
# `Settings` a propósito: se lee con `database_admin_url()`, que falla si el
# perfil es `api`, y `scripts/check_env_parity.py` rechaza que aparezca en
# render.yaml. Cutover del rol de runtime: scripts/setup_pg_roles.sql y
# docs/runbooks/persistence-tripwires.md.
# DATABASE_ADMIN_URL=postgresql://<rol-dueño>:<pass>@<host>:5432/<db>?sslmode=verify-full  # pragma: allowlist secret

# ── Redis (cache compartido + rate limiting) ──────────────────────────
# Formato: redis://[:password@]host[:port][/db]
# En Docker Compose usar: redis://:${REDIS_PASSWORD}@redis:6379/0
# Obligatorio en ENV=prod.
# REDIS_URL=redis://localhost:6379/0

# Contraseña de Redis. Obligatorio en ENV=prod. Debe coincidir con --requirepass del servidor.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
# REDIS_PASSWORD=cambia-esto-por-una-password-segura

# Backend de rate limiting: "sqlite" (default) o "redis".
# RATE_LIMIT_BACKEND=redis

# ── Rutas (opcionales) ────────────────────────────────────────────────
# DATA_DIR=data

# OAuth Google (opcional)
# GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<client-secret>
# OAUTH_REDIRECT_URI=http://localhost:3000
# OAUTH_ALLOWED_EMAILS=persona@empresa.com,otra@empresa.com
# OAUTH_ALLOWED_DOMAINS=empresa.com
# OAUTH_ADMIN_EMAILS=admin@empresa.com
# SIGNING_KEY=<clave-aleatoria-32-chars>

# Seguridad API (recomendado, obligatorio en ENV=prod)
# API_HMAC_SECRET=<secreto-hmac-32+-chars>
# API keys nuevas: mínimo privilegio y vencimiento obligatorio. Evita usar '*'
# salvo credenciales break-glass con control de cambios.
# API_KEY_DEFAULT_SCOPES=data:read
# API_KEY_DEFAULT_TTL_DAYS=90
# API_KEY_MAX_TTL_DAYS=365
# IDEMPOTENCY_TTL_SECONDS=86400
# DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=30
# Clave independiente para integridad de auditoría (no reutilizar otros secretos).
# AUDIT_HMAC_KEY=<secreto-hmac-32+-chars>
# Todo backup local o remoto se cifra con GPG/AES-256; obligatorio al ejecutarlo.
# BACKUP_ENCRYPTION_KEY=<passphrase-aleatoria-larga>

# Firma de webhooks. Obligatorio en ENV=prod (cae a SIGNING_KEY si está vacío).
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
# WEBHOOK_SIGNING_KEY=<clave-aleatoria-32+-chars>
# Solo se permiten destinos HTTPS de esta lista (separada por comas); no uses '*'.
# WEBHOOK_ALLOWED_HOSTS=hooks.slack.com,api.example.com
# Documentos: allowlist SSRF de hosts desde los que se descargan pliegos. El
# valor por defecto se deriva del inventario de fuentes
# (`scraper/connectors/__init__.py::dominios_documentos_por_defecto`) y un test
# exige que coincidan: una fuente que enlace pliegos declara ahí su dominio.
DOCUMENT_ALLOWED_HOSTS=contrataciondelestado.es,*.contrataciondelestado.es
# Seguimiento unificado (ADR-031 §B, fase 2): favoritos, empresas vigiladas y
# descartes del Radar leen QUÉ sigue el usuario de la tabla `follows` en vez de
# su tabla de origen. Encender sólo con `scripts/check_follows_paridad.py` a
# cero diferencias contra producción; apagarlo es la vuelta atrás, sin deploy.
# FOLLOWS_LECTURA=false
# Ficha estructurada de pliegos (requiere credencial del proveedor del modelo).
# PLIEGO_FACTS_ENABLED=false
# PLIEGO_FACTS_MODEL=deepseek-ai/deepseek-v4-pro
# Lotes por fase del job de pliegos (scheduler/jobs/documentos_embeddings.py).
# PLIEGO_FETCH_BATCH=300
# PLIEGO_EMBED_BATCH=100
# PLIEGO_FACTS_BATCH=25
# Extraer la ficha en background al abrir una oportunidad si aún no existe
# (un LLM por pursuit nuevo, como mucho). Independiente del lote nocturno.
# PLIEGO_FACTS_ON_PURSUIT=true
# PLIEGO_TECH_SIGNAL_BATCH=500
# PLIEGO_TECH_MIN_SCORE=0.5
# Maestro de órganos (ADR-032): grafías nuevas resueltas por cierre y su presupuesto.
# ORGANOS_RESOLVE_MAX_GRAFIAS=500
# ORGANOS_RESOLVE_BUDGET_S=120
# El alta por contraseña se desactiva por defecto; usa OAuth/SSO en producción.
ALLOW_SELF_REGISTRATION=false

# Cifrado de secretos TOTP (2FA). OBLIGATORIO en ENV=prod: la app falla al
# arrancar el flujo TOTP si está vacío (en dev usa clave efímera con warning).
# Genera una clave Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOTP_ENCRYPTION_KEY=<clave-fernet-base64>

# Sesiones de navegador (cookie `session`), deslizantes: cada petición
# autenticada vuelve a poner el plazo de inactividad en now + SESSION_IDLE_HOURS,
# nunca más allá del techo created_at + SESSION_ABSOLUTE_DAYS (sin renovación
# posible; las acciones sensibles siguen exigiendo login reciente aparte).
# «Recordar este equipo» en el login alarga la ventana de inactividad a
# SESSION_REMEMBER_DAYS con el mismo techo (la tabla `sessions` no distingue
# ambos tipos): con los valores por defecto una sesión recordada no caduca por
# inactividad y muere a los 30 días del login.
# SESSION_IDLE_HOURS=24
# SESSION_ABSOLUTE_DAYS=30
# SESSION_REMEMBER_DAYS=90

# CORS — orígenes permitidos (separados por coma). En ENV=prod, si está vacío
# se bloquean TODAS las solicitudes cross-origin (warning al arrancar).
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Origen del frontend al que vuelve el callback de OAuth (éxito o error). Sin
# ella, `api/routes/auth.py` redirige a http://localhost:3000.
# FRONTEND_URL=https://app.example.com

# API detrás de proxy (uvicorn)
# Restringe qué IPs/rangos pueden enviar X-Forwarded-* confiables.
# Ejemplo: FORWARDED_ALLOW_IPS=127.0.0.1,10.0.0.0/8
# FORWARDED_ALLOW_IPS=127.0.0.1

# ── IA / LLM (endpoint /api/v1/ask) ───────────────────────────────────
# Proveedor por defecto: NVIDIA NIM (API compatible con OpenAI).
# Modelo por defecto: deepseek-ai/deepseek-v4-pro
# Consigue la clave en https://build.nvidia.com (formato: nvapi-...).
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Endpoint NVIDIA (opcional, default ya apunta al oficial):
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
#
# Proveedores alternativos (opcionales, solo si usas modelos gpt-*/claude-*):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Métricas y observabilidad ─────────────────────────────────────────
# IPs que pueden scrapear /metrics (Prometheus). Por defecto solo loopback.
# METRICS_ALLOWED_IPS=127.0.0.1,10.0.0.5
# Tracing distribuido OTLP (opcional; sin endpoint, tracing opera en modo NoOp).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=licitaciones-sap
# OTEL_SAMPLE_RATIO=0.1
# Sentry (opt-in): sin DSN, `observability/sentry.py` no hace nada y no hay
# captura de errores. Requiere además `sentry-sdk`, que no está en requirements.
# SENTRY_DSN=https://<clave>@<org>.ingest.sentry.io/<proyecto>

# ── Imagen Docker (solo build) ────────────────────────────────────────
# Lockfile que instala `docker/Dockerfile.api` (ARG). Por defecto el de la API,
# sin scikit-learn/statsmodels/networkx; el worker usa el del pipeline.
# REQUIREMENTS_FILE=requirements-api.txt

# ── Alertas por email (opcional) ──────────────────────────────────────
# Si ALERT_EMAIL_TO está definido, ALERT_SMTP_PASSWORD es obligatorio.
# ALERT_EMAIL_TO=ops@empresa.com
# ALERT_MIN_LEVEL=warn
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=<usuario-smtp>
# ALERT_SMTP_PASSWORD=<password-o-app-password>
#
# ── Correo transaccional: backend de envío ────────────────────────────
# Todo el correo del producto (alertas, invitaciones, recuperación de
# contraseña, digests, avisos de acceso) sale por observability/mailer.py.
# EMAIL_BACKEND elige el transporte: `smtp` (default; usa ALERT_SMTP_*),
# `resend`, `postmark` o `console` (solo escribe al log: desarrollo y tests).
# Con resend/postmark en ENV=prod, EMAIL_API_KEY y EMAIL_FROM son
# obligatorios, y EMAIL_FROM debe ser de un dominio verificado en el proveedor
# (SPF/DKIM/DMARC). Ver docs/runbooks/correo-transaccional.md.
# EMAIL_BACKEND=smtp
# EMAIL_FROM=no-reply@tudominio.es
# EMAIL_FROM_NAME=TenderFlow
# EMAIL_REPLY_TO=soporte@tudominio.es
# EMAIL_API_KEY=<clave-del-proveedor>
#
# Segundo canal del plano Prometheus+Alertmanager (observability/alertmanager.yml).
# Opcional por diseño: vacío deja el receptor `webhook` sin destino real y el de
# email sigue funcionando. Aquí va la URL de un dead-man's-switch
# (healthchecks.io, Better Stack, Cronitor): es lo único que detecta que el
# Watchdog DEJÓ de llegar, que es la mitad que importa.
# Ver docs/runbooks/observability-alerts.md.
# ALERTMANAGER_WEBHOOK_URL=https://hc-ping.com/<uuid>
#
# Puerto en el que escucha el contenedor de Alertmanager
# (docker/docker-entrypoint-alertmanager.sh usa `${PORT:-9093}`). NO lo lee
# `config/settings.py`: es una variable del proceso de Alertmanager, no de la
# aplicación Python. Se declara explícitamente en el servicio de `render.yaml`
# porque Render inyecta su propio `PORT` (10000) cuando el servicio no lo trae,
# y entonces el enrutado de `observability/prometheus.render.yml`
# (`tenderflow-alertmanager:9093`) apuntaría a un puerto donde no hay nadie.
# PORT=9093

# ── Cola de tareas (Dramatiq, opcional) ───────────────────────────────
# Vacío = StubBroker síncrono (dev/tests). En prod: broker Redis/RabbitMQ.
# DRAMATIQ_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1

# ── Pool de conexiones a BD (tuning, opcional) ────────────────────────
# Son DOS pools: escritura (`connect`) y lectura (`connect_read`). El techo
# de conexiones del proceso es la suma de ambos, y tiene que caber en el
# `Pool Size` del session pooler de Supabase — si no, el connect muere con
# `EMAXCONNSESSION` y se lleva por delante también a `alembic upgrade`.
# Ver el bloque «Presupuesto de conexiones» de render.yaml.
# DB_POOL_SIZE=5
# DB_READ_POOL_SIZE=0   # 0 = hereda DB_POOL_SIZE (no significa «sin pool»)
# DB_POOL_TIMEOUT=10.0

# NOTA: config/settings.py declara más knobs de tuning (umbrales ML, anomalías,
# circuit breaker, límites de descarga…) con defaults seguros. Consultá ese
# archivo para la lista completa; aquí solo se documentan los relevantes para
# desplegar/operar de forma segura.

# LLM: tope de tokens por guion de oferta técnica (F2.6). Es un tope por
# respuesta, no un presupuesto — el gasto acumulado lo gobierna el BudgetGuard.
# LLM_GUION_MAX_TOKENS=2500

# Monitoring (Grafana)
# GF_SECURITY_ADMIN_PASSWORD=<password-admin-grafana>

# Scheduler Docker (opcional)
# SCHEDULER_DAILY_INTERVAL_MINUTES=240
# SCHEDULER_BULK_INTERVAL_MINUTES=1440
# SCHEDULER_BULK_MONTHS=3

# Plano de cron: quién mira el reloj en ESTE entorno (ADR-012, ADR-033).
# Un solo valor activo; los procesos de los otros dos planos se niegan a
# arrancar su bucle, que es preferible a que arranquen los dos.
#
#   actions  — GitHub Actions (el de producción hoy). Es también el efecto de
#              dejar la variable sin definir.
#   docker   — `scheduler/loop.py`, el stack de docker-compose local.
#   worker   — el cron dentro del proceso APP_PROFILE=worker (ADR-033). Poner
#              esto es el cutover; el procedimiento y la vuelta atrás están en
#              docs/runbooks/cutover-cron-al-worker.md.
#
# En Render va con `sync: false` a propósito (ver render.yaml): el valor lo
# manda el dashboard, no este fichero.
# SCHEDULER_PLANE=actions

# ══════════════════════════════════════════════════════════════════════
# Plan de arquitectura 2026-09 v2 — secciones por stream
#
# Cada stream declara SUS variables bajo SU ancla y no toca las demás: así
# varios agentes editan este fichero sin pisarse. Cuando el plan cierre se
# consolidan con el resto.
# ══════════════════════════════════════════════════════════════════════

# ── ANCLA S1 — identidad y equipo (OIDC, invitaciones) ────────────────
# Microsoft Entra ID (D17). Vacío = proveedor apagado: /auth/oauth/microsoft/
# authorize responde 501 y el login no ofrece el botón.
# El redirect URI que hay que registrar en Entra ID es el mismo de Google con
# el proveedor cambiado, p. ej.:
#   https://api.tuservicio.com/api/v1/auth/oauth/microsoft/callback
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# Tenant del documento de descubrimiento. "common" (default) es multi-tenant:
# quién puede entrar lo siguen decidiendo OAUTH_ALLOWED_DOMAINS y access_grants.
# Un GUID o un dominio restringen el login a ese único tenant.
# OAUTH_MICROSOFT_TENANT=common

# ── ANCLA S5 — cola de trabajo y worker ───────────────────────────────
# La cola vive en la tabla `jobs` (v106). Ninguna de estas variables es
# obligatoria: todas tienen defecto en config/settings.py y un valor
# ilegible se ignora en vez de tumbar el arranque.
#
# Para consumir la cola en local: APP_PROFILE=worker (arranca api.app con
# solo el router de salud y el consumidor en un hilo) o, para depurar,
# `python -m scheduler.worker`.

# Segundos que un job puede estar `running` sin señales antes de que otro
# worker lo reclame. Es lo que hace que un despliegue a mitad de una
# extracción no la pierda; súbelo solo si algún handler tarda más que esto.
# JOBS_LOCK_TTL_SEGUNDOS=900

# Intentos totales por job (la primera ejecución cuenta).
# JOBS_MAX_INTENTOS=3

# Base del backoff exponencial entre reintentos: 30 s, 60 s, 120 s…
# JOBS_BACKOFF_BASE_SEGUNDOS=30

# Espera del worker con la cola vacía. Es el retardo máximo que ve quien
# acaba de pulsar «Extraer ficha».
# JOBS_WORKER_POLL_SEGUNDOS=5

# A partir de cuántas filas PEDIDAS `GET /exports/download?format=pdf` deja
# de maquetar en la request y devuelve 202 con un job_id. El PDF resultante
# viaja por la caché compartida, así que este camino necesita REDIS_URL: sin
# Redis, worker y API no ven el mismo objeto. Sube el umbral (o deja el
# camino síncrono) en un despliegue sin Redis.
# JOBS_EXPORT_UMBRAL_FILAS=20000

# ¿El cierre post-ingesta encola sus 15 pasos en vez de ejecutarlos en
# línea? Por defecto sí: cada paso deja su estado y su error en `jobs`. A 0
# vuelve al camino en línea sin desplegar código.
# JOBS_CIERRE_POR_COLA=1

# ── ANCLA S8 — documentos: almacén de objetos y OCR ───────────────────
# Almacén opcional de los binarios de documentos (`shared/object_store.py`).
# Sin configurar, la ingesta sigue y el binario no se conserva.
# auto (defecto) → filesystem si hay DOCUMENT_BLOB_DIR, s3 si hay bucket, si no disabled.
# DOCUMENT_BLOB_BACKEND=auto
# Bucket S3-compatible (R2, Supabase Storage, MinIO); credenciales con las AWS_* de boto3.
# DOCUMENT_BLOB_BUCKET=tenderflow-documentos
# Endpoint del proveedor S3-compatible; vacío = AWS.
# DOCUMENT_BLOB_ENDPOINT_URL=https://<cuenta>.r2.cloudflarestorage.com
# Región del bucket (defecto: auto).
# DOCUMENT_BLOB_REGION=auto
# Prefijo de las claves dentro del bucket (defecto: documentos/).
# DOCUMENT_BLOB_PREFIX=documentos/
# Raíz del backend de sistema de ficheros (dev local o disco persistente).
# DOCUMENT_BLOB_DIR=data/blobs
# ── Retención de datos ───────────────────────────────────────────
# Plazos que aplica el job `retention_cleanup`. La tabla publicada —con el
# motivo de cada plazo— está en docs/SECURITY.md y se genera con
# `python scripts/gen_retention_doc.py`. Cambiar uno de estos valores cambia
# ese documento: regenerálo en el mismo commit o CI lo rechaza.
#
# `0` desactiva la purga de esa tabla. Un valor negativo lo rechaza el
# validador de `config/settings.py` al arrancar.
# RETENTION_EXTRACTION_RUNS_DAYS=90
# RETENTION_AUDIT_LOG_DAYS=180
# RETENTION_DLQ_DAYS=30
# RETENTION_LICITACIONES_HISTORY_DAYS=365
# RETENTION_ACCESS_LOG_DAYS=180
# RETENTION_IDEMPOTENCY_KEYS_DAYS=1
# RETENTION_WEBHOOK_DELIVERIES_DAYS=90
# RETENTION_CLIENT_ERRORS_DAYS=30
# RETENTION_ASISTENTE_FEEDBACK_DAYS=365
# RETENTION_PASSWORD_RESET_DAYS=7
#
# OJO: este plazo está PUBLICADO en el aviso legal
# (web/src/lib/legal.ts::LEGAL_MESES_RETENCION_SOLICITUDES). Los dos números
# tienen que coincidir —lo comprueba tests/test_retention_solicitudes.py—
# porque una divergencia convierte el aviso en una promesa falsa.
# RETENTION_SOLICITUDES_ACCESO_MESES=24

# ── Presupuesto LLM por organización (C2.9) ──────────────────────────────
# El tope por usuario evita que una cuenta agote la ventana global; no evita
# que una organización con veinte cuentas lo haga entre todas. Este cubo es el
# reparto entre clientes. Por defecto igual al tope diario global, o sea que
# una sola organización puede agotarlo — que es el comportamiento anterior.
# `0` o negativo lo desactiva, igual que sus hermanos.
# LLM_BUDGET_USD_DAILY_PER_ORG=5.0
