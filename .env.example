# Variables de entorno — copia este archivo como .env y rellena los valores
# NUNCA commitees .env al repositorio

# ── Entorno ─────────────────────────────────────────────────────────
# Default: prod (fail-safe). Usar dev solo en desarrollo local.
# En dev: CORS wildcard habilitado, DB init errors no fatales.
# ENV=dev
ENV=prod

# ── Base de datos ──────────────────────────────────────────────────────
# Opción A: SQLite local (por defecto, sin configuración adicional)
# DB_PATH=data/licitaciones.db

# Opción B: Turso cloud (ambas variables son obligatorias si se usa Turso)
# TURSO_DATABASE_URL=libsql://<tu-db>.<region>.turso.io
# TURSO_AUTH_TOKEN=<jwt-token-con-permisos-rw>

# Ruta del archivo de réplica local de Turso (opcional, default: data/licitaciones_replica.db)
# TURSO_LOCAL_DB=data/licitaciones_replica.db

# ── Redis (cache compartido + rate limiting) ──────────────────────────
# Formato: redis://[:password@]host[:port][/db]
# En Docker Compose usar: redis://:${REDIS_PASSWORD}@redis:6379/0
# Obligatorio en ENV=prod.
# REDIS_URL=redis://localhost:6379/0

# Contraseña de Redis. Obligatorio en ENV=prod. Debe coincidir con --requirepass del servidor.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
# REDIS_PASSWORD=cambia-esto-por-una-password-segura

# Backend de rate limiting: "sqlite" (default) o "redis".
# RATE_LIMIT_BACKEND=redis

# ── Dashboard ─────────────────────────────────────────────────────────
# Contraseña para proteger el dashboard. Dejar vacío para deshabilitar autenticación.
# DASHBOARD_PASSWORD=cambia-esto-por-una-contraseña-segura# Hash bcrypt (preferido sobre contraseña plana). Generar con:
#   python scripts/hash_password.py
# DASHBOARD_PASSWORD_HASH=$2b$12$...
# ── Rutas (opcionales) ────────────────────────────────────────────────
# DATA_DIR=data

# OAuth Google (opcional)
# GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<client-secret>
# OAUTH_REDIRECT_URI=http://localhost:8501
# OAUTH_ALLOWED_EMAILS=persona@empresa.com,otra@empresa.com
# OAUTH_ALLOWED_DOMAINS=empresa.com
# OAUTH_ADMIN_EMAILS=admin@empresa.com
# SIGNING_KEY=<clave-aleatoria-32-chars>

# Seguridad API (recomendado, obligatorio en ENV=prod)
# API_HMAC_SECRET=<secreto-hmac-32+-chars>

# API detrás de proxy (uvicorn)
# Restringe qué IPs/rangos pueden enviar X-Forwarded-* confiables.
# Ejemplo: FORWARDED_ALLOW_IPS=127.0.0.1,10.0.0.0/8
# FORWARDED_ALLOW_IPS=127.0.0.1

# Monitoring (Grafana)
# GF_SECURITY_ADMIN_PASSWORD=<password-admin-grafana>

# Scheduler Docker (opcional)
# SCHEDULER_DAILY_INTERVAL_MINUTES=240
# SCHEDULER_BULK_INTERVAL_MINUTES=1440
# SCHEDULER_BULK_MONTHS=3
