# Variables de entorno — copia este archivo como .env y rellena los valores
# NUNCA commitees .env al repositorio

# ── Entorno ─────────────────────────────────────────────────────────
# Default: prod (fail-safe). Usar dev solo en desarrollo local.
# En dev: CORS wildcard habilitado, DB init errors no fatales.
# ENV=dev
ENV=prod

# Perfil de componentes que arranca el proceso. Eje independiente de ENV:
# ENV dice qué datos se tocan, APP_PROFILE qué se arranca.
#   api     — sirve HTTP: exige SIGNING_KEY, API_HMAC_SECRET, REDIS_URL, CORS.
#   scraper — cron de ingesta: solo validators de BD y alertas.
#   worker  — jobs de fondo: igual que scraper.
APP_PROFILE=api

# ── Base de datos ──────────────────────────────────────────────────────
# Postgres es el ÚNICO motor soportado (ADR-021): dev, CI y producción.
# SQLite se retiró — `DB_PATH` ya no existe.
#
# Dev local: `docker compose up -d postgres` levanta el servicio del compose.
#   DATABASE_URL=postgresql://tenderflow:tenderflow@localhost:5432/tenderflow?sslmode=disable  # pragma: allowlist secret -- contenedor local de dev, no es una credencial real
# `sslmode=disable` sólo es aceptable contra localhost (sin red que interceptar);
# config/settings.py lo rechaza contra cualquier host remoto, sea cual sea ENV.
#
# Producción: Postgres / Supabase (ADR-016).
# Usar el Supavisor *session pooler* (puerto 5432; IPv4, compatible con GH Actions).
# TLS: en ENV=prod/staging se recomienda verify-full + la CA de Supabase para
# prevenir MITM (sslmode=require cifra pero NO valida el certificado del servidor).
# NOTA: sslmode=disable/allow/prefer se RECHAZAN en prod/staging (no garantizan TLS).
# DATABASE_URL=postgresql://<user>:<pass>@<host>:5432/<db>?sslmode=verify-full  # pragma: allowlist secret
# Ruta al certificado CA raíz de Supabase (Dashboard → Database → SSL → download).
# Requerido para verify-full. No es un secreto (cert público).
# DATABASE_SSL_ROOT_CERT=db/certs/prod-ca-2021.crt
# Timeouts server-side aplicados a cada conexión del pool (ms). Protegen el pool
# frente a queries descontroladas o transacciones idle. 0 = sin límite.
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_TX_TIMEOUT_MS=60000
# DB_CONNECT_TIMEOUT=10

# ── Redis (cache compartido + rate limiting) ──────────────────────────
# Formato: redis://[:password@]host[:port][/db]
# En Docker Compose usar: redis://:${REDIS_PASSWORD}@redis:6379/0
# Obligatorio en ENV=prod.
# REDIS_URL=redis://localhost:6379/0

# Contraseña de Redis. Obligatorio en ENV=prod. Debe coincidir con --requirepass del servidor.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
# REDIS_PASSWORD=cambia-esto-por-una-password-segura

# Backend de rate limiting: "sqlite" (default) o "redis".
# RATE_LIMIT_BACKEND=redis

# ── Rutas (opcionales) ────────────────────────────────────────────────
# DATA_DIR=data

# OAuth Google (opcional)
# GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<client-secret>
# OAUTH_REDIRECT_URI=http://localhost:3000
# OAUTH_ALLOWED_EMAILS=persona@empresa.com,otra@empresa.com
# OAUTH_ALLOWED_DOMAINS=empresa.com
# OAUTH_ADMIN_EMAILS=admin@empresa.com
# SIGNING_KEY=<clave-aleatoria-32-chars>

# Seguridad API (recomendado, obligatorio en ENV=prod)
# API_HMAC_SECRET=<secreto-hmac-32+-chars>
# API keys nuevas: mínimo privilegio y vencimiento obligatorio. Evita usar '*'
# salvo credenciales break-glass con control de cambios.
# API_KEY_DEFAULT_SCOPES=data:read
# API_KEY_DEFAULT_TTL_DAYS=90
# API_KEY_MAX_TTL_DAYS=365
# IDEMPOTENCY_TTL_SECONDS=86400
# DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=30
# Clave independiente para integridad de auditoría (no reutilizar otros secretos).
# AUDIT_HMAC_KEY=<secreto-hmac-32+-chars>
# Todo backup local o remoto se cifra con GPG/AES-256; obligatorio al ejecutarlo.
# BACKUP_ENCRYPTION_KEY=<passphrase-aleatoria-larga>

# Firma de webhooks. Obligatorio en ENV=prod (cae a SIGNING_KEY si está vacío).
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
# WEBHOOK_SIGNING_KEY=<clave-aleatoria-32+-chars>
# Solo se permiten destinos HTTPS de esta lista (separada por comas); no uses '*'.
# WEBHOOK_ALLOWED_HOSTS=hooks.slack.com,api.example.com
# Documentos: allowlist de PLACSP, ampliable solo con fuentes auditadas.
DOCUMENT_ALLOWED_HOSTS=contrataciondelestado.es,*.contrataciondelestado.es
# Ficha estructurada de pliegos (requiere credencial del proveedor del modelo).
# PLIEGO_FACTS_ENABLED=false
# PLIEGO_FACTS_MODEL=deepseek-ai/deepseek-v4-pro
# Lotes por fase del job de pliegos (scheduler/jobs/documentos_embeddings.py).
# PLIEGO_FETCH_BATCH=300
# PLIEGO_EMBED_BATCH=100
# PLIEGO_FACTS_BATCH=25
# Extraer la ficha en background al abrir una oportunidad si aún no existe
# (un LLM por pursuit nuevo, como mucho). Independiente del lote nocturno.
# PLIEGO_FACTS_ON_PURSUIT=true
# PLIEGO_TECH_SIGNAL_BATCH=500
# PLIEGO_TECH_MIN_SCORE=0.5
# El alta por contraseña se desactiva por defecto; usa OAuth/SSO en producción.
ALLOW_SELF_REGISTRATION=false

# Cifrado de secretos TOTP (2FA). OBLIGATORIO en ENV=prod: la app falla al
# arrancar el flujo TOTP si está vacío (en dev usa clave efímera con warning).
# Genera una clave Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOTP_ENCRYPTION_KEY=<clave-fernet-base64>

# CORS — orígenes permitidos (separados por coma). En ENV=prod, si está vacío
# se bloquean TODAS las solicitudes cross-origin (warning al arrancar).
# CORS_ALLOWED_ORIGINS=https://app.example.com

# API detrás de proxy (uvicorn)
# Restringe qué IPs/rangos pueden enviar X-Forwarded-* confiables.
# Ejemplo: FORWARDED_ALLOW_IPS=127.0.0.1,10.0.0.0/8
# FORWARDED_ALLOW_IPS=127.0.0.1

# ── IA / LLM (endpoint /api/v1/ask) ───────────────────────────────────
# Proveedor por defecto: NVIDIA NIM (API compatible con OpenAI).
# Modelo por defecto: deepseek-ai/deepseek-v4-pro
# Consigue la clave en https://build.nvidia.com (formato: nvapi-...).
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Endpoint NVIDIA (opcional, default ya apunta al oficial):
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
#
# Proveedores alternativos (opcionales, solo si usas modelos gpt-*/claude-*):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Métricas y observabilidad ─────────────────────────────────────────
# IPs que pueden scrapear /metrics (Prometheus). Por defecto solo loopback.
# METRICS_ALLOWED_IPS=127.0.0.1,10.0.0.5
# Tracing distribuido OTLP (opcional; sin endpoint, tracing opera en modo NoOp).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=licitaciones-sap
# OTEL_SAMPLE_RATIO=0.1

# ── Alertas por email (opcional) ──────────────────────────────────────
# Si ALERT_EMAIL_TO está definido, ALERT_SMTP_PASSWORD es obligatorio.
# ALERT_EMAIL_TO=ops@empresa.com
# ALERT_MIN_LEVEL=warn
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=<usuario-smtp>
# ALERT_SMTP_PASSWORD=<password-o-app-password>

# ── Cola de tareas (Dramatiq, opcional) ───────────────────────────────
# Vacío = StubBroker síncrono (dev/tests). En prod: broker Redis/RabbitMQ.
# DRAMATIQ_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1

# ── Pool de conexiones a BD (tuning, opcional) ────────────────────────
# Son DOS pools: escritura (`connect`) y lectura (`connect_read`). El techo
# de conexiones del proceso es la suma de ambos, y tiene que caber en el
# `Pool Size` del session pooler de Supabase — si no, el connect muere con
# `EMAXCONNSESSION` y se lleva por delante también a `alembic upgrade`.
# Ver el bloque «Presupuesto de conexiones» de render.yaml.
# DB_POOL_SIZE=5
# DB_READ_POOL_SIZE=0   # 0 = hereda DB_POOL_SIZE (no significa «sin pool»)
# DB_POOL_TIMEOUT=10.0

# NOTA: config/settings.py declara más knobs de tuning (umbrales ML, anomalías,
# circuit breaker, límites de descarga…) con defaults seguros. Consultá ese
# archivo para la lista completa; aquí solo se documentan los relevantes para
# desplegar/operar de forma segura.

# LLM: tope de tokens por guion de oferta técnica (F2.6). Es un tope por
# respuesta, no un presupuesto — el gasto acumulado lo gobierna el BudgetGuard.
# LLM_GUION_MAX_TOKENS=2500

# Monitoring (Grafana)
# GF_SECURITY_ADMIN_PASSWORD=<password-admin-grafana>

# Scheduler Docker (opcional)
# SCHEDULER_DAILY_INTERVAL_MINUTES=240
# SCHEDULER_BULK_INTERVAL_MINUTES=1440
# SCHEDULER_BULK_MONTHS=3
