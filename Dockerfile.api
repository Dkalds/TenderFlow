# ── Etapa 1: builder ──────────────────────────────────────────────────────────
FROM python:3.13.13-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt pyproject.toml ./
RUN pip install --upgrade "pip>=26.1" \
    && pip install --prefix=/install --no-cache-dir -r requirements.txt


# ── Etapa 2: imagen de producción — FastAPI / uvicorn ────────────────────────
FROM python:3.13.13-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONHASHSEED=random

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

RUN useradd --create-home --shell /bin/bash --uid 1001 appuser

WORKDIR /app

COPY --from=builder /install /usr/local
COPY --chown=appuser:appuser . .

RUN pip install --no-cache-dir --no-deps . \
    && find /usr/local/lib/python3.13 -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true \
    && find /usr/local/lib/python3.13 -name '*.pyc' -delete

RUN mkdir -p /data && chown appuser:appuser /data
ENV DB_PATH=/data/licitaciones.db \
    DATA_DIR=/data \
    FORWARDED_ALLOW_IPS=127.0.0.1

EXPOSE 8080

RUN chmod +x docker-entrypoint-api.sh

USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl --fail --silent --max-time 5 http://localhost:8080/api/v1/health || exit 1

ENTRYPOINT ["docker-entrypoint-api.sh"]
CMD ["--workers", "2"]
