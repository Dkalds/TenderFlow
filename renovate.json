{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeMinor"
  ],
  "timezone": "Europe/Madrid",
  "schedule": ["every weekend"],
  "labels": ["dependencies"],
  "assignees": [],
  "reviewers": [],

  "packageRules": [
    {
      "groupName": "all non-major (minor + patch)",
      "matchManagers": ["pip-compile", "pip_requirements", "github-actions", "dockerfile"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "schedule": ["every weekend"]
    },
    {
      "groupName": "all major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "prPriority": -1,
      "schedule": ["before 6am on monday"]
    },
    {
      "groupName": "Python ML & Data",
      "matchManagers": ["pip-compile", "pip_requirements"],
      "matchPackageNames": [
        "scikit-learn",
        "sentence-transformers",
        "faiss-cpu",
        "statsmodels",
        "evidently",
        "scipy"
      ],
      "automerge": false
    },
    {
      "groupName": "FastAPI ecosystem",
      "matchManagers": ["pip-compile", "pip_requirements"],
      "matchPackageNames": [
        "fastapi",
        "uvicorn",
        "httpx",
        "pydantic",
        "pydantic-settings"
      ],
      "automerge": false
    },
    {
      "groupName": "Streamlit & dashboard",
      "matchManagers": ["pip-compile", "pip_requirements"],
      "matchPackageNames": [
        "streamlit",
        "plotly",
        "pandas",
        "numpy"
      ],
      "automerge": false
    },
    {
      "groupName": "Observability",
      "matchManagers": ["pip-compile", "pip_requirements"],
      "matchPackageNames": [
        "opentelemetry-sdk",
        "opentelemetry-exporter-otlp",
        "structlog",
        "prometheus-client"
      ],
      "automerge": true
    },
    {
      "groupName": "Security & auth",
      "matchManagers": ["pip-compile", "pip_requirements"],
      "matchPackageNames": [
        "argon2-cffi",
        "cryptography",
        "pyotp",
        "python-jose"
      ],
      "automerge": false
    },
    {
      "groupName": "Dev & CI tools",
      "matchManagers": ["pip-compile", "pip_requirements"],
      "matchPackagePatterns": ["^pytest", "^bandit", "^ruff", "^mypy"],
      "automerge": true
    },
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "automerge": true
    },
    {
      "groupName": "Docker base images",
      "matchManagers": ["dockerfile"],
      "automerge": false
    }
  ],

  "pip-compile": {
    "fileMatch": ["(^|/)requirements.*\\.in$"]
  },

  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },

  "prConcurrentLimit": 5,
  "prHourlyLimit": 2
}
