# ── Etapa 1: builder ──────────────────────────────────────────────────────────
FROM python:3.13.16-slim-bookworm AS builder

# Cache-bust: 2026-05-31 (force dep reinstall after httpx addition)
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# C3.1 — corte API / pipeline (2026-09-18).
#
# La imagen instala por defecto `requirements-api.txt`: sin lxml, scikit-learn,
# scipy, statsmodels ni networkx. Los caminos de request que los usaban
# degradan de forma visible (cabecera de `requirements-api.in`) y
# `tests/test_unit_api_imagen_slim.py` prueba en un proceso aparte que
# `api.app` arranca con esos paquetes vetados.
#
# `REQUIREMENTS_FILE` elige la variante, y hay dos usos legítimos de la otra:
#
# - **El worker** (`render.yaml::tenderflow-worker`, `APP_PROFILE=worker`)
#   corre la misma imagen pero ejecuta el plano de cron —drift, precálculo de
#   clusters, reintentos de la DLQ contra TACRC— y necesita el conjunto del
#   pipeline. Render pasa las variables de entorno del servicio como build
#   args, así que la declara allí.
# - **Vuelta atrás sin tocar código**: si retirar `/explain` de la imagen
#   resulta inaceptable antes de que la RFC
#   `docs/rfc/2026-09-18-rfc-explain-fuera-del-proceso-api.md` se resuelva,
#   `REQUIREMENTS_FILE=requirements-pipeline.txt` devuelve el conjunto anterior
#   (mismos pines que `requirements.txt`, salvo el plano MCP;
#   `check_requirements_sync.py` lo vigila).
# - **El servidor MCP interno** (`render.yaml::tenderflow-mcp`, 2026-10-15)
#   corre esta misma imagen con `REQUIREMENTS_FILE=requirements-mcp.txt`: el
#   conjunto de la API más el SDK `mcp`. Arranca con `python -m mcp_server`, que
#   el entrypoint ejecuta tal cual cuando recibe un comando en vez de opciones.
#
# El CI construye las dos variantes (`.github/workflows/ci.yml::docker-build`).
ARG REQUIREMENTS_FILE=requirements-api.txt
COPY requirements-api.txt requirements-pipeline.txt requirements-mcp.txt pyproject.toml ./
RUN pip install --upgrade "pip>=26.1" \
    && pip install --prefix=/install --no-cache-dir --require-hashes -r "${REQUIREMENTS_FILE}"

# Modelo ONNX con el que la API codifica la CONSULTA de la búsqueda por
# significado (`services/embeddings_onnx.py`; backlog P2 «La búsqueda por
# significado no corre en producción»). Es el mismo
# `paraphrase-multilingual-MiniLM-L12-v2` con el que el pipeline embebió
# `documento_chunks`, exportado a ONNX: ~470 MB en disco y en memoria una vez
# cargado (perezosamente, en la primera búsqueda), sin PyTorch.
#
# Revisión fija (un commit del repo de Hugging Face, no una rama) y sha256 de
# cada fichero: `descargar_modelo_embeddings.py` no tiene modo «sin
# verificar». Sin `EMBEDDINGS_ONNX_REVISION` no descarga nada y la imagen sale
# como antes: es el caso del CI y de los servicios que no la declaran (el
# worker y el MCP no codifican consultas). Render pasa las variables del
# servicio como build args, así que se declaran en `tenderflow-api`; los
# valores y cómo obtenerlos están en `docs/runbooks/model-rollback.md`
# § «Modelo ONNX de embeddings», verificados el 2026-10-25. No van como valores
# por defecto aquí porque esta imagen también la construyen el CI y servicios
# que no codifican consultas: con defaults, todos bajarían ~470 MB. La fusión
# que el modelo habilita está además detrás de la flag `busqueda_semantica`.
ARG EMBEDDINGS_ONNX_REPO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ARG EMBEDDINGS_ONNX_REVISION=
ARG EMBEDDINGS_ONNX_SHA256_MODELO=
ARG EMBEDDINGS_ONNX_SHA256_TOKENIZADOR=
ARG EMBEDDINGS_ONNX_SHA256_CONFIG=
COPY scripts/descargar_modelo_embeddings.py ./
RUN python descargar_modelo_embeddings.py --destino /modelos/embeddings


# ── Etapa 2: imagen de producción — FastAPI / uvicorn ────────────────────────
FROM python:3.13.16-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONHASHSEED=random

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

RUN useradd --create-home --shell /bin/bash --uid 1001 appuser

WORKDIR /app

COPY --from=builder /install /usr/local
COPY --from=builder /modelos /opt/modelos
COPY --chown=appuser:appuser . .

# El `pip` que viaja en la imagen NO es el de la etapa builder: `COPY
# --from=builder /install /usr/local` trae las dependencias, pero el instalador
# que queda en la etapa runtime es el que trae `python:3.13.13-slim`, y ese es
# el que Trivy escanea — por él reportaba un CVE alto.
#
# **No se actualiza: se RETIRA.** Actualizarlo fue el primer intento y salió
# peor: dejaba en la imagen un `pip` nuevo con su `msgpack` vendorizado
# (GHSA-6v7p-g79w-8964) y el `setuptools` 70.3.0 de la base (CVE-2025-47273),
# o sea que cambiaba un hallazgo alto por dos. La imagen de ejecución no
# instala nada: arranca `uvicorn`. Un instalador ahí es superficie sin
# contrapartida, y es justo lo que usaría alguien con ejecución de código para
# traerse la siguiente etapa.
#
# El proyecto se instala ANTES de retirarlo, con `--no-deps` desde el checkout:
# sin `-r requirements.txt` y por tanto sin `--require-hashes`, así que no hay
# verificación de hashes en juego. Los pines con hash se siguen resolviendo en
# la etapa builder, que fija `pip>=26.1`.
RUN pip install --no-cache-dir --no-deps . \
    && pip uninstall --yes pip setuptools wheel \
    && find /usr/local/lib/python3.13 -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true \
    && find /usr/local/lib/python3.13 -name '*.pyc' -delete

RUN mkdir -p /data && chown appuser:appuser /data
# El modelo ONNX solo se activa si el build lo descargó: `${VAR:+valor}` deja
# la variable vacía (motor desactivado) cuando no hubo revisión, en vez de
# apuntar a un directorio vacío y avisar en cada arranque de que falta.
ARG EMBEDDINGS_ONNX_REVISION=
ENV EMBEDDINGS_ONNX_DIR=${EMBEDDINGS_ONNX_REVISION:+/opt/modelos/embeddings}

# Sin DB_PATH: SQLite se retiró en ADR-021; el único motor es Postgres vía
# DATABASE_URL.
ENV DATA_DIR=/data \
    FORWARDED_ALLOW_IPS=127.0.0.1 \
    # ── Memoria — Render Free es 512 MB. ────────────────────────────────────
    # glibc malloc abre por defecto 8×CPU arenas que fragmentan el heap; con
    # 2 arenas el RSS baja 50-150 MB en stacks pandas/numpy/sklearn. Y bajar
    # el trim threshold fuerza a devolver páginas libres al SO antes.
    MALLOC_ARENA_MAX=2 \
    MALLOC_TRIM_THRESHOLD_=131072

EXPOSE 8080

RUN chmod +x docker/docker-entrypoint-api.sh

USER appuser

# `HEALTHCHECK_PATH` (por defecto el de la API) la fija el servicio MCP a
# `/healthz`: su proceso no monta `/api/v1/health`, y sin esto Docker lo daría
# por no saludable aunque sirva bien. Render usa su propio `healthCheckPath`.
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl --fail --silent --max-time 5 "http://localhost:${PORT:-8080}${HEALTHCHECK_PATH:-/api/v1/health}" || exit 1

ENTRYPOINT ["./docker/docker-entrypoint-api.sh"]
CMD ["--workers", "1"]
